{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6380"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "flashstore",
    "Password": ""
  },
  "Jwt": {
    "Issuer": "flashstore-api",
    "Audience": "flashstore-clients",
    "ExpiresMinutes": 60,
    "Key": ""
  },
  "Inventory": {
    "Strategy": "Atomic",
    "UnsafeDelayMs": 50
  },
  "RateLimit": {
    "LoginPermitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "Swagger": {
    "Enabled": true
  }
}
