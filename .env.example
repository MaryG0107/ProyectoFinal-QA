# =============================================================
# FlashStore - Variables de entorno
# Copie este archivo como .env y cambie TODOS los valores.
# El archivo .env NUNCA se sube al repositorio (.gitignore).
# =============================================================

# PostgreSQL
POSTGRES_DB=flashstore
POSTGRES_USER=flashstore
POSTGRES_PASSWORD=cambie-esta-clave-postgres

# RabbitMQ
RABBITMQ_USER=flashstore
RABBITMQ_PASSWORD=cambie-esta-clave-rabbitmq

# JWT: mínimo 32 caracteres. Genérela con:  openssl rand -base64 48
JWT_KEY=cambie-esta-llave-por-una-aleatoria-de-al-menos-32-caracteres

# Estrategia de inventario:
#   Atomic -> correcta (release GO)
#   Unsafe -> sobreventa intencional para el escenario NO-GO (release rc1)
INVENTORY_STRATEGY=Atomic

# Intentos de login por minuto por IP. Para la prueba k6 de 300 usuarios use 1000.
LOGIN_RATE_LIMIT=10

# Falla simulada en un consumidor para demostrar reintentos y DLQ.
# Valores: vacío (sin falla), orders, inventory, notifications
SIMULATE_CONSUMER_FAILURE=

# Origen permitido para la PWA (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
